# Copy this to .env for local `vercel dev` runs. In production these are set
# as Vercel Environment Variables instead (Project Settings → Environment
# Variables) — see README.md for the full walkthrough.

# The *entire* service-account JSON key file content, as one line.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ...}

# Optional — these default to the Sheet/Drive folder already baked into
# lib/config.js. Only set these if you want to point at a different
# Sheet/Drive folder (e.g. a staging copy) without a code change.
# SHEET_ID=1pQFjICQRG3GcLLy7PxQl2U_wa6oZsALNIysZJytnGMc
# DRIVE_ROOT_ID=18Pec9FZckf1c16uMkLkeUVfW33Hk-4BB
